{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "uglink-console",
	"main": "src/interfaces/http/console/worker.ts",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "CONSOLE_SESSIONS",
			"id": "019ae894ef574a0680bd38a1db2821aa"
		},
		{
			"binding": "uglink_worker_uglink_cache",
			"id": "019ae894ef574a0680bd38a1db2821aa",
			"remote": true
		}
	],
	"vars": {
		"CONSOLE_TITLE": "UGLINK Control"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
