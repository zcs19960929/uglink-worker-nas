{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uglink-worker",
  "main": "src/interfaces/http/gateway/entry.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "UGLINK_SESSIONS", "class_name": "UgreenSessionCoordinator" }]
  },
  "migrations": [{ "tag": "uglink-sessions-v1", "new_sqlite_classes": ["UgreenSessionCoordinator"] }],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "UGLINK_CONTROL_MANAGED": "v1",
    "UGLINK_ID": "",
    "USERNAME": "",
    "SERVICE_MAP": "{}",
    "SETUP_MODE": "true",
    "SESSION_NAMESPACE": "setup"
  },
  "kv_namespaces": [
    {
      "binding": "UGLINK_CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
